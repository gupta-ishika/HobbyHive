# HobbyHive Backend Environment Variables

# App Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security / JWT
JWT_SECRET_KEY=change_this_to_a_super_secret_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite:///./hobbyhive.db
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/hobbyhive

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
